# À définir dans PowerShell avant de démarrer le backend, ou utiliser scripts/start-reporting.ps1.
# ONMT_DEMO concerne les analyses et l'identité simulées ; les modèles IA restent réels.
ONMT_DEMO=1
ONMT_DEMO_EMBEDDINGS=0
ONMT_GENERATION_MODE=ollama
ONMT_OLLAMA_MODEL=onmt-qwen25:3b
ONMT_OLLAMA_TIMEOUT=240
ONMT_OLLAMA_CONTEXT=3072
ONMT_EMBEDDING_MODEL=local_data/models/multilingual-e5-small
ONMT_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
ONMT_MAX_DISTANCE=0.24
ONMT_OCR=1
ONMT_TESSERACT=local_data/tools/tesseract/tesseract.exe
ONMT_TESSDATA=local_data/tools/tesseract/tessdata
